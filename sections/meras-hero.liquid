{% liquid
  assign hero_product = section.settings.product
  if hero_product == blank
    assign hero_product = collections.all.products.first
  endif
%}
<section class="hero" id="top">
  <div class="hero-media">
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '750,1100,1500,1800', alt: section.settings.heading }}
    {% elsif hero_product.featured_image %}
      {{ hero_product.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '750,1100,1500,1800', alt: hero_product.title }}
    {% endif %}
  </div>
  <div class="hero-copy">
    <span class="eyebrow">مجموعة مِراس</span>
    <h1>{{ section.settings.heading }} <span>{{ section.settings.heading_accent }}</span></h1>
    <p>{{ section.settings.text }}</p>
    <div class="hero-actions">
      <a class="button button-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      <a class="button button-light" href="#story">قصة مِراس</a>
    </div>
    <div class="founder">
      <span>برؤية</span>
      <strong>{{ settings.founder_name | default: 'منى الطحاوي' }}</strong>
      <small>Founder of Meras</small>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meras hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "صورة الهيرو" },
    { "type": "product", "id": "product", "label": "منتج بديل للصورة" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "حضوركِ" },
    { "type": "text", "id": "heading_accent", "label": "تكملة العنوان", "default": "له أثر." },
    { "type": "textarea", "id": "text", "label": "الوصف", "default": "عبايات ودريسات بتفاصيل هادئة، قصّات مريحة، وحضور أنثوي لا يحتاج إلى مبالغة." },
    { "type": "text", "id": "button_label", "label": "نص الزر", "default": "اكتشفي المجموعة" },
    { "type": "url", "id": "button_link", "label": "رابط الزر" }
  ],
  "presets": [{ "name": "Meras hero" }]
}
{% endschema %}
