{% liquid
  assign hero_product = section.settings.product
  if hero_product == blank
    assign hero_product = collections.all.products.first
  endif
%}
<section class="hero hero-premium" id="top">
  <div class="hero-copy">
    <div class="hero-topline">
      <span class="eyebrow">MERAS · CAIRO · 2026</span>
      <span class="hero-drop">01 / NEW DROP</span>
    </div>

    <h1>{{ section.settings.heading }} <span>{{ section.settings.heading_accent }}</span></h1>
    <p>{{ section.settings.text }}</p>

    <div class="hero-actions">
      <a class="button button-dark" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>
      <a class="text-action" href="#story">قصة مِراس <span>↙</span></a>
    </div>

    <div class="hero-brand-strip">
      <div><small>FOUNDED BY</small><strong>{{ settings.founder_name | default: 'منى الطحاوي' }}</strong></div>
      <div><small>STYLE</small><strong>Quiet statement</strong></div>
      <div><small>DELIVERY</small><strong>داخل مصر</strong></div>
    </div>
  </div>

  <div class="hero-media">
    <span class="hero-media-label">Mِراس — أثر يُرى</span>
    {% if section.settings.image != blank %}
      {{ section.settings.image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '750,1100,1500,1800', alt: section.settings.heading }}
    {% elsif hero_product.featured_image %}
      {{ hero_product.featured_image | image_url: width: 1800 | image_tag: loading: 'eager', widths: '750,1100,1500,1800', alt: hero_product.title }}
    {% endif %}
    <div class="hero-stamp" aria-hidden="true"><span>مِ</span><small>MERAS</small></div>
  </div>
</section>

{% schema %}
{
  "name": "Meras hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "صورة الهيرو" },
    { "type": "product", "id": "product", "label": "منتج بديل للصورة" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "حضوركِ" },
    { "type": "text", "id": "heading_accent", "label": "تكملة العنوان", "default": "له أثر." },
    { "type": "textarea", "id": "text", "label": "الوصف", "default": "عبايات ودريسات معاصرة بتفاصيل مدروسة، ألوان لها شخصية، وقصّات سهلة تعيش معكِ." },
    { "type": "text", "id": "button_label", "label": "نص الزر", "default": "تسوّقي الجديد" },
    { "type": "url", "id": "button_link", "label": "رابط الزر" }
  ],
  "presets": [{ "name": "Meras hero" }]
}
{% endschema %}
