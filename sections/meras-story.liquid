<section class="story" id="story" data-reveal data-founder-version="2">
  <div class="story-founder-card" aria-label="منى الطحاوي — المؤسسة والمالكة">
    <div class="story-founder-monogram" aria-hidden="true">مِ</div>
    <div class="story-founder-meta">
      <span>FOUNDER · MERAS</span>
      <strong>{{ settings.founder_name | default: 'منى الطحاوي' }}</strong>
      <small>المؤسسة والمالكة</small>
    </div>
  </div>

  <div class="story-copy">
    <span class="eyebrow">THE MERAS STORY</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="story-values" aria-label="قيم مِراس">
      <span>قصّات مدروسة</span>
      <span>ألوان لها شخصية</span>
      <span>أناقة هادئة</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meras story",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "مِراس هو ما يبقى من الأثر." },
    { "type": "textarea", "id": "text", "label": "النص", "default": "برؤية منى الطحاوي، تقدّم مِراس أزياء نسائية عربية معاصرة تجمع بين الحضور الهادئ والتفاصيل المدروسة. كل قطعة تُختار لتكون قريبة من المرأة، من يومها، ومن طريقتها الخاصة في الأناقة." }
  ],
  "presets": [{ "name": "Meras story" }]
}
{% endschema %}
