<section class="story" id="story">
  <div class="story-mark">مِ</div>
  <div>
    <span class="eyebrow">THE STORY</span>
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
    <div class="story-founder">
      <strong>{{ settings.founder_name | default: 'منى الطحاوي' }}</strong>
      <span>المؤسسة والمالكة</span>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Meras story",
  "settings": [
    { "type": "text", "id": "heading", "label": "العنوان", "default": "مِراس هو ما يبقى من الأثر." },
    { "type": "textarea", "id": "text", "label": "النص", "default": "علامة مصرية تنطلق من فكرة بسيطة: أن الأناقة الحقيقية لا تحتاج أن تكون صاخبة. كل قطعة تُختار لتكون قريبة من المرأة، من يومها، ومن طريقتها الخاصة في الحضور." }
  ],
  "presets": [{ "name": "Meras story" }]
}
{% endschema %}
