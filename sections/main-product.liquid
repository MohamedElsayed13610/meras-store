<section class="product-page product-page-premium">
  <div class="product-gallery">
    {% for image in product.images limit: 4 %}
      <figure class="product-gallery-item {% if forloop.first %}is-primary{% endif %}">
        {{ image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '500,800,1100,1400', alt: product.title }}
      </figure>
    {% endfor %}
  </div>

  <div class="product-info product-info-sticky">
    <div class="product-breadcrumb">مِراس / {{ product.type | default: 'COLLECTION' }}</div>
    <h1>{{ product.title }}</h1>
    <div class="product-price-line">
      <span class="price" data-product-price>{{ product.selected_or_first_available_variant.price | money }}</span>
      <span class="tax-note">السعر شامل الضريبة إن وجدت</span>
    </div>

    {% if product.description != blank %}
      <div class="product-description">{{ product.description }}</div>
    {% else %}
      <div class="product-description">قطعة من مجموعة مِراس بقصّة أنيقة وتفاصيل هادئة، مصممة لتناسب الإطلالات اليومية والمناسبات.</div>
    {% endif %}

    {% form 'product', product, class: 'product-form', data-ajax-cart-form: '' %}
      {% unless product.has_only_default_variant %}
        <fieldset class="size-picker" data-size-picker>
          <legend>اختاري المقاس</legend>
          {% for variant in product.variants %}
            <label class="size-chip {% unless variant.available %}is-disabled{% endunless %}">
              <input
                type="radio"
                name="id"
                value="{{ variant.id }}"
                data-variant-price="{{ variant.price | money | escape }}"
                {% if variant == product.selected_or_first_available_variant %}checked{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
              <span>{{ variant.title }}</span>
            </label>
          {% endfor %}
        </fieldset>
      {% else %}
        <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
      {% endunless %}

      <div class="purchase-row">
        <div class="qty-wrap">
          <label for="Quantity-{{ section.id }}">الكمية</label>
          <input class="qty" id="Quantity-{{ section.id }}" type="number" name="quantity" min="1" value="1">
        </div>
        <button class="add-button" type="submit" {% unless product.selected_or_first_available_variant.available %}disabled{% endunless %}>
          <span>{% if product.selected_or_first_available_variant.available %}أضيفي إلى السلة{% else %}غير متاح حاليًا{% endif %}</span>
          <span aria-hidden="true">+</span>
        </button>
      </div>
    {% endform %}

    <div class="fit-note">
      <span>المقاسات المتاحة</span>
      <strong>S · M · L · XL · 2XL · 3XL · 4XL</strong>
    </div>

    <div class="product-services">
      <div><strong>دفع آمن</strong><span>Checkout من Shopify</span></div>
      <div><strong>الدفع عند الاستلام</strong><span>متاح حسب منطقة الشحن</span></div>
      <div><strong>خدمة العملاء</strong><span>مساعدة قبل وبعد الطلب</span></div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('change', function(event) {
    if (!event.target.matches('[data-size-picker] input[name="id"]')) return;
    var price = event.target.getAttribute('data-variant-price');
    var priceNode = document.querySelector('[data-product-price]');
    if (priceNode && price) priceNode.textContent = price;
  });
</script>

{% schema %}
{
  "name": "Main product",
  "settings": []
}
{% endschema %}
