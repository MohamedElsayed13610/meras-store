{% liquid
  assign chosen_collection = section.settings.collection
  if chosen_collection == blank
    assign products_to_show = collections.all.products
  else
    assign products_to_show = chosen_collection.products
  endif
%}

<section class="meras-categories" aria-label="أقسام مِراس">
  <a class="category-pill category-pill--sand" href="/collections/العبايات"><span>01</span><strong>العبايات</strong><small>قصّات مميزة</small></a>
  <a class="category-pill category-pill--rose" href="/collections/دريسات"><span>02</span><strong>الدريسات</strong><small>أناقة يومية</small></a>
  <a class="category-pill category-pill--sage" href="/collections/يومية"><span>03</span><strong>يومية</strong><small>راحة وحضور</small></a>
  <a class="category-pill category-pill--wine" href="/collections/مناسبات"><span>04</span><strong>مناسبات</strong><small>تفاصيل أرقى</small></a>
</section>

<section class="section section-products" id="new">
  <div class="section-head compact-head">
    <div>
      <span class="eyebrow">NEW EDIT · 2026</span>
      <h2>{{ section.settings.heading }}</h2>
    </div>
    <p>{{ section.settings.text }}</p>
  </div>

  <div class="products" id="collection">
    {% for product in products_to_show limit: section.settings.products_to_show %}
      {% liquid
        assign product_tone = 'tone-stone'
        if product.title contains 'أسود'
          assign product_tone = 'tone-black'
        elsif product.title contains 'بيج' or product.title contains 'أوف وايت' or product.title contains 'أبيض'
          assign product_tone = 'tone-sand'
        elsif product.title contains 'سماوي' or product.title contains 'أزرق'
          assign product_tone = 'tone-blue'
        elsif product.title contains 'رمادي'
          assign product_tone = 'tone-grey'
        elsif product.title contains 'موف' or product.title contains 'بنفسجي'
          assign product_tone = 'tone-mauve'
        elsif product.title contains 'خردلي' or product.title contains 'ذهبي'
          assign product_tone = 'tone-gold'
        elsif product.title contains 'عنابي' or product.title contains 'أحمر'
          assign product_tone = 'tone-wine'
        elsif product.title contains 'أخضر'
          assign product_tone = 'tone-green'
        elsif product.title contains 'كحلي'
          assign product_tone = 'tone-navy'
        endif
        assign selected_variant = product.selected_or_first_available_variant
      %}

      <article class="product-card {{ product_tone }}" data-reveal>
        <a class="product-media" href="{{ product.url }}" aria-label="{{ product.title | escape }}">
          <span class="product-index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          <span class="product-swatch" aria-hidden="true"></span>
          {% if product.featured_image %}
            {{ product.featured_image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '360,540,720,900', alt: product.title }}
          {% endif %}
          <span class="product-view">عرض التفاصيل</span>
        </a>

        <div class="product-info-row">
          <a class="product-copy" href="{{ product.url }}">
            <span class="product-kicker">MERAS · {{ product.type | default: 'COLLECTION' }}</span>
            <h3>{{ product.title }}</h3>
          </a>
          <strong class="product-price">{{ product.price | money }}</strong>
        </div>

        {% if selected_variant %}
          <form class="quick-add" method="post" action="{{ routes.cart_add_url }}" data-ajax-cart-form>
            <input type="hidden" name="id" value="{{ selected_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" {% unless selected_variant.available %}disabled{% endunless %}>
              <span>{% if selected_variant.available %}أضيفي إلى السلة{% else %}غير متاح{% endif %}</span>
              <span class="quick-add-icon" aria-hidden="true">+</span>
            </button>
          </form>
        {% endif %}
      </article>
    {% else %}
      <p>أضيفي منتجاتك من Shopify لتظهر هنا تلقائيًا.</p>
    {% endfor %}
  </div>
</section>

<section class="editorial editorial-compact" id="occasion">
  <div class="editorial-copy">
    <span class="eyebrow">THE OCCASION EDIT</span>
    <h2>تفاصيل هادئة.<br><em>أثر واضح.</em></h2>
    <p>تصميمات مِراس تعتمد على التوازن بين القَصّة، اللون، والحركة — بدون مبالغة.</p>
    <a class="button button-outline-light" href="/collections/مناسبات">استكشفي المناسبات</a>
  </div>
  <div class="editorial-signature" aria-hidden="true">M</div>
</section>

{% schema %}
{
  "name": "Meras featured products",
  "settings": [
    { "type": "collection", "id": "collection", "label": "المجموعة" },
    { "type": "text", "id": "heading", "label": "العنوان", "default": "مختارات مِراس" },
    { "type": "textarea", "id": "text", "label": "الوصف", "default": "مجموعة منتقاة بتفاصيل واضحة وألوان لها شخصية، مصممة لتكون جزءًا من يومك." },
    { "type": "range", "id": "products_to_show", "label": "عدد المنتجات", "min": 4, "max": 12, "step": 1, "default": 8 }
  ],
  "presets": [{ "name": "Meras featured products" }]
}
{% endschema %}
