<div class="announcement">
  <span>مِراس — شحن داخل مصر</span>
  <span class="announcement-dot">•</span>
  <span>الدفع عند الاستلام متاح</span>
</div>
<header class="nav">
  <nav class="nav-links" aria-label="التنقل الرئيسي">
    <a href="{{ routes.root_url }}#new">الجديد</a>
    <a href="/collections/العبايات">عبايات</a>
    <a href="/collections/دريسات">دريسات</a>
    <a href="/collections/مناسبات">مناسبات</a>
  </nav>

  <a class="brand" href="{{ routes.root_url }}" aria-label="مِراس - الرئيسية">
    <span class="brand-ar">مِراس</span>
    <span class="brand-en">MERAS</span>
  </a>

  <div class="nav-actions">
    <a class="about-link" href="{{ routes.root_url }}#story">عن مِراس</a>
    <button class="cart-trigger" type="button" data-cart-open aria-label="فتح سلة مِراس">
      <span class="cart-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" focusable="false">
          <path d="M6.8 8.5h10.4l.9 11H5.9l.9-11Z"></path>
          <path d="M9 9V6.8a3 3 0 0 1 6 0V9"></path>
        </svg>
      </span>
      <span class="sr-only">السلة</span>
      <b data-cart-count>{{ cart.item_count }}</b>
    </button>
  </div>
</header>

{% schema %}
{
  "name": "Meras header",
  "settings": []
}
{% endschema %}
